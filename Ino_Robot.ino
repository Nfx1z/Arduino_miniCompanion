#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>
#include <Adafruit_SHT31.h>
#include <DFRobotDFPlayerMini.h>

// ============================================================================
//  PIN DEFINITIONS
// ============================================================================
#define PIN_I2C_SDA         6
#define PIN_I2C_SCL         7
#define PIN_DFPLAYER_RX     1   // ESP32 RX  <-- DFPlayer TX
#define PIN_DFPLAYER_TX     0   // ESP32 TX  -> (1k ohm resistor) -> DFPlayer RX
#define PIN_PIR             4
#define PIN_TTP_RUB_1       5   // Robot mode: rub sensor 1 | MP3 mode: vol up / next
#define PIN_TTP_RUB_2       10  // Robot mode: rub sensor 2 | MP3 mode: vol down / previous
#define PIN_TTP_MODE        3   // Hold 5s: toggles Robot <-> MP3

// ============================================================================
//  DISPLAY
// ============================================================================
#define SCREEN_WIDTH        128
#define SCREEN_HEIGHT       64
#define OLED_RESET          -1
#define OLED_I2C_ADDR       0x3C

// ============================================================================
//  AUDIO DEFAULTS
// ============================================================================
#define ROBOT_DEFAULT_VOLUME    25   // DFPlayer volume used in Robot mode (0-30)

// ============================================================================
//  MPU6500 (raw register driver)
// ============================================================================
#define MPU_ADDR            0x68
#define REG_PWR_MGMT_1      0x6B
#define REG_ACCEL_CONFIG    0x1C
#define REG_ACCEL_XOUT_H    0x3B
const float MPU_ACCEL_SCALE = 16384.0f;  // LSB/g at +/-2g range
const float MPU_GRAVITY     = 9.80665f;

// ============================================================================
//  TIMING CONSTANTS (milliseconds)
// ============================================================================
#define PLAIN_INACTIVITY_SLEEP_MS 120000UL // No rub activity in PLAIN this long -> sleep
                                            // (only checked once the angry/sad cycle for
                                            // this wake has already been used up)
#define SLEEP_PIR_REARM_DELAY   30000UL  // ignore PIR for this long right after entering sleep
#define RUB_RESET_TIMEOUT       500UL    // 500 ms no touch resets rub accumulator
#define TEMP_READ_INTERVAL          5000UL  // Read SHT30D every 5 s normally
#define TEMP_COOLDOWN_READ_INTERVAL 500UL   // Read every 0.5s during the 10s cooldown window
// State durations
#define DUR_ANGRY               60000UL
#define DUR_SAD                 30000UL
#define DUR_HAPPY               30000UL
#define DUR_DIZZY               30000UL
#define DUR_HOT                 60000UL
#define DUR_FREEZE              60000UL
#define DUR_TEMP_COOLDOWN       10000UL
#define DUR_PLAIN_ANGRY_TRIGGER 60000UL  // Time in plain before angry triggers
#define DUR_WAKE_RUB_LOOP_HOLD_MS 3000UL // How long to stay in the plain loop (after the
                                          // intro finishes) before moving on to happy.
                                          // The intro's own length comes from seqWakeRubIntro
                                          // itself -- see computeDerivedDurations() in setup().

// Rub thresholds
#define RUB_WAKE_THRESHOLD      4000UL   // 4 s rub from sleep
#define RUB_HAPPY_THRESHOLD     2000UL   // 2 s rub from plain

// Sensor thresholds
#define TEMP_HOT_THRESHOLD      33.0f
#define TEMP_COLD_THRESHOLD     20.0f
#define TILT_DELTA_THRESHOLD_DEG 30.0f

// MP3 mode timings/behavior
#define MODE_HOLD_MS             5000UL  // hold Mode button this long to switch
// Wake-from-sleep gesture: tap the Mode button WAKE_TAP_COUNT times in a row.
// Configurable -- set to 2 for double-tap, 3 for triple-tap, etc.
#define WAKE_TAP_COUNT           2
#define WAKE_TAP_MAX_PRESS_MS    400UL   // a press longer than this is a hold, not a tap
#define WAKE_TAP_MAX_GAP_MS      500UL   // max gap between taps to still count as one sequence
// In MP3 mode, tap this many times to toggle looping the current track on/off.
// Uses the same tap-timing constants above (WAKE_TAP_MAX_PRESS_MS / WAKE_TAP_MAX_GAP_MS).
#define MP3_LOOP_TOGGLE_TAP_COUNT 2
#define VOLUME_HOLD_MS           2000UL  // hold vol button this long before it ramps
#define VOLUME_RAMP_INTERVAL_MS  400UL   // step every this many ms while ramping
#define MUSIC_DEFAULT_VOLUME     20      // reset to this on every mode entry
#define MUSIC_VOLUME_MAX         30
#define MUSIC_VOLUME_MIN         0
#define MUSIC_FRAME_DURATION_MS  250UL   // how long each of the 3 MP3-mode frames shows before switching

#define FOLDER_ROBOT  1
#define FOLDER_MP3    2

// ============================================================================
//  ENUMERATIONS
// ============================================================================

// Audio tracks -- match file numbers within /01/ on the SD card (001.mp3 = TRACK_SLEEP, etc.)
enum AudioTrack : uint8_t {
    TRACK_NONE = 0,
    TRACK_SLEEP = 1,
    TRACK_GREET,          // 2
    TRACK_ANGRY,          // 3
    TRACK_SAD,            // 4
    TRACK_HAPPY,          // 5
    TRACK_HAPPY_SLEEP,    // 6
    TRACK_ANGRY_HAPPY,    // 7
    TRACK_SAD_HAPPY,      // 8
    TRACK_DIZZY,          // 9
    TRACK_HOT,            // 10
    TRACK_FREEZE,         // 11
    TRACK_WAKE            // 12 -- plays during the wake-rub sequence, before happy_sleep.mp3
};

// OLED frame indices (must match frameBitmaps[] order)
enum FrameIndex : uint8_t {
    FR_SLEEP_01 = 0,
    FR_SLEEP_02,
    FR_PLAIN_01,
    FR_PLAIN_02,
    FR_ANGRY_01,
    FR_ANGRY_02,
    FR_SAD_01,
    FR_SAD_02,
    FR_HAPPY_00,
    FR_HAPPY_01,
    FR_HAPPY_02,
    FR_DIZZY_01,
    FR_DIZZY_02,
    FR_DIZZY_03,
    FR_DIZZY_04,
    FR_HOT_01,
    FR_HOT_02,
    FR_FREEZE_01,
    FR_FREEZE_02,
    FR_MUSIC_01,
    FR_MUSIC_02,
    FR_MUSIC_03,
    FRAME_COUNT           // = 22
};

// Robot-mode (emotion) states
enum State : uint8_t {
    ST_SLEEP = 0,
    ST_PLAIN,
    ST_ANGRY,
    ST_SAD,
    ST_HAPPY,
    ST_DIZZY,
    ST_HOT,
    ST_FREEZE,
    ST_WAKE_RUB,          // Transitional: sleep -> rub -> happy
    ST_TEMP_COOLDOWN,     // 10 s plain after hot/freeze before re-check
    STATE_COUNT
};

// Top-level operating mode -- only two, toggled by holding Mode (pin 9)
enum OpMode : uint8_t {
    MODE_ROBOT = 0,   // the animatronic/emotion state machine (default)
    MODE_MP3          // simple music player, files 001..N inside /02/ on the SD card
};

// ============================================================================
//  DATA STRUCTURES
// ============================================================================
struct AnimFrame {
    uint8_t  frameIdx;
    uint16_t durationMs;
};

struct AnimSequence {
    const AnimFrame* intro;
    uint8_t          introLen;
    const AnimFrame* loop;
    uint8_t          loopLen;
};

// Tracks a button's hold state for long-press / ramp detection
struct ButtonHoldState {
    bool          pressed        = false;
    unsigned long pressStart     = 0;
    bool          longActionDone = false;  // guards against re-triggering while held
    unsigned long lastStepTime   = 0;
};

