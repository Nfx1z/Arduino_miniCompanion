// ============================================================================
//  MPU6500 RAW REGISTER DRIVER
// ============================================================================
void mpuWriteReg(uint8_t reg, uint8_t val) {
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(reg);
    Wire.write(val);
    Wire.endTransmission();
}

void mpuInit() {
    mpuWriteReg(REG_PWR_MGMT_1, 0x00);   // wake -- defaults to sleep on power-up
    delay(50);
    mpuWriteReg(REG_ACCEL_CONFIG, 0x00); // +/-2g range, matches MPU_ACCEL_SCALE
    delay(10);
}

bool mpuReadAccel(int16_t &ax, int16_t &ay, int16_t &az) {
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(REG_ACCEL_XOUT_H);
    if (Wire.endTransmission(false) != 0) return false;
    if (Wire.requestFrom(MPU_ADDR, (uint8_t)6) != 6) return false;

    ax = (Wire.read() << 8) | Wire.read();
    ay = (Wire.read() << 8) | Wire.read();
    az = (Wire.read() << 8) | Wire.read();
    return true;
}

float wrapDelta(float delta) {
    while (delta > 180.0f)  delta -= 360.0f;
    while (delta < -180.0f) delta += 360.0f;
    return delta;
}
// ============================================================================
//  SETUP
// ============================================================================

// Sums the frame durations of an AnimFrame sequence. Used so state-transition
// timing can be derived from the animation data itself instead of a hand-kept
// duplicate constant that silently goes stale when you edit the sequence.
unsigned long sumSeqDuration(const AnimFrame* seq, uint8_t len) {
    unsigned long total = 0;
    for (uint8_t i = 0; i < len; i++) total += seq[i].durationMs;
    return total;
}

void computeDerivedDurations() {
    DUR_WAKE_RUB_TOTAL = sumSeqDuration(seqWakeRubIntro, 1) + DUR_WAKE_RUB_LOOP_HOLD_MS;
}

void setup() {
    Serial.begin(115200);
    delay(300);
    Serial.println(F("\n--- Companion Boot (v2) ---"));

    computeDerivedDurations();

    // -- GPIO --
    pinMode(PIN_PIR,       INPUT);
    pinMode(PIN_TTP_RUB_1, INPUT);
    pinMode(PIN_TTP_RUB_2, INPUT);
    pinMode(PIN_TTP_MODE,  INPUT);

    // -- I2C --
    Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
    Wire.setClock(400000);

    // -- OLED --
    if (!display.begin(OLED_I2C_ADDR, true)) {
        Serial.println(F("[ERR] SH1106 alloc failed"));
        while (true) { yield(); }
    }
    display.clearDisplay();
    display.display();
    Serial.println(F("[OK ] OLED SH1106"));

    Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
    Wire.setClock(400000);

    // -- DFPlayer Mini --
    dfSerial.begin(9600, SERIAL_8N1, PIN_DFPLAYER_RX, PIN_DFPLAYER_TX);
    Serial.println(F("Waiting 3s for DFPlayer SD initialization..."));
    delay(3000);  // this module needs the full 3s -- 500ms was too short
    if (!dfPlayer.begin(dfSerial, false, true)) {  // isACK=false, doReset=true
        Serial.println(F("[ERR] DFPlayer not found"));
    } else {
        dfPlayer.setTimeOut(500);
        dfPlayer.volume(ROBOT_DEFAULT_VOLUME);
        dfPlayer.EQ(0);
        dfPlayer.outputDevice(DFPLAYER_DEVICE_SD);
        Serial.println(F("[OK ] DFPlayer"));
    }

    // -- MPU6500 (raw driver -- see header comment) --
    mpuInit();
    Serial.println(F("[OK ] MPU6500 woken + configured"));

    // -- SHT30D --
    if (!sht30.begin(0x44)) {
        Serial.println(F("[ERR] SHT30D not found"));
    } else {
        Serial.println(F("[OK ] SHT30D"));
    }

    Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
    Wire.setClock(400000);

    // -- Enter initial mode/state --
    currentMode = MODE_ROBOT;
    enterState(ST_SLEEP);
    Serial.println(F("--- Ready ---"));
}

// ============================================================================
//  ENTER STATE (Robot mode -- unchanged from v1)
// ============================================================================
void enterState(State newState) {
    previousState   = currentState;
    currentState    = newState;
    stateStartTime  = millis();

    const AnimSequence& anim = stateAnimations[newState];
    if (anim.introLen > 0) {
        animPhase    = PHASE_INTRO;
        animFrameIdx = 0;
        displayFrame(anim.intro[0].frameIdx);
    } else if (anim.loopLen > 0) {
        animPhase    = PHASE_LOOP;
        animFrameIdx = 0;
        displayFrame(anim.loop[0].frameIdx);
    }
    lastFrameChange = millis();

    switch (newState) {
        case ST_SLEEP:
            stateAudioTrack = TRACK_SLEEP;
            cycleAngryUsed        = false;
            cycleSadUsed          = false;
            happyPreventsAngrySad = false;
            break;
        case ST_PLAIN:
            stateAudioTrack = TRACK_NONE;
            break;
        case ST_ANGRY:
            stateAudioTrack = TRACK_ANGRY;
            cycleAngryUsed  = true;
            break;
        case ST_SAD:
            stateAudioTrack = TRACK_SAD;
            cycleSadUsed    = true;
            break;
        case ST_HAPPY:
            if (stateAudioTrack == TRACK_NONE) stateAudioTrack = TRACK_HAPPY;
            happyPreventsAngrySad = true;
            break;
        case ST_DIZZY:
            stateAudioTrack = TRACK_DIZZY;
            break;
        case ST_HOT:
            stateAudioTrack = TRACK_HOT;
            break;
        case ST_FREEZE:
            stateAudioTrack = TRACK_FREEZE;
            break;
        case ST_WAKE_RUB:
            stateAudioTrack = TRACK_WAKE;   // plays through the plain_02+plain sequence, until happy_sleep.mp3 takes over
            break;
        case ST_TEMP_COOLDOWN:
            stateAudioTrack = TRACK_NONE;
            break;
        default:
            stateAudioTrack = TRACK_NONE;
            break;
    }

    playAudio(stateAudioTrack);

    Serial.print(F("STATE -> "));
    Serial.println(newState);
}

// ============================================================================
//  DISPLAY A SINGLE FRAME
// ============================================================================
void displayFrame(uint8_t frameIdx) {
    if (frameIdx >= FRAME_COUNT) return;
    display.clearDisplay();
    display.drawBitmap(0, 0, frameBitmaps[frameIdx],
                       SCREEN_WIDTH, SCREEN_HEIGHT, SH110X_WHITE);
    display.display();
}

// ============================================================================
//  ANIMATION ENGINE (Robot mode -- unchanged)
// ============================================================================
void updateAnimation(unsigned long now) {
    const AnimSequence& anim = stateAnimations[currentState];

    const AnimFrame* seq;
    uint8_t          seqLen;

    if (animPhase == PHASE_INTRO && anim.introLen > 0) {
        seq    = anim.intro;
        seqLen = anim.introLen;
    } else {
        seq    = anim.loop;
        seqLen = anim.loopLen;
        if (animPhase == PHASE_INTRO) animPhase = PHASE_LOOP;
    }

    if (seqLen == 0) return;

    if (now - lastFrameChange >= seq[animFrameIdx].durationMs) {
        animFrameIdx++;

        if (animFrameIdx >= seqLen) {
            if (animPhase == PHASE_INTRO && anim.introLen > 0) {
                animPhase    = PHASE_LOOP;
                animFrameIdx = 0;
                seq          = anim.loop;
                seqLen       = anim.loopLen;
            } else {
                animFrameIdx = 0;
            }
        }

        if (seqLen > 0) {
            displayFrame(seq[animFrameIdx].frameIdx);
        }
        lastFrameChange = now;
    }
}

// ============================================================================
//  SERIAL DEBUG: type a number + Enter in the Serial Monitor (115200 baud) to
//  play that RAW file position directly, bypassing every mode/state/array in
//  this sketch entirely. Use this to build a ground-truth map of "position N
//  actually contains X" by ear, instead of guessing at filename vs. FAT order.
// ============================================================================
void handleSerialDebug() {
    if (Serial.available()) {
        int n = Serial.parseInt();
        while (Serial.available()) Serial.read();   // flush the rest of the line
        if (n > 0) {
            Serial.print(F("[DEBUG] Playing raw file position "));
            Serial.println(n);
            dfPlayer.play(n);
        }
    }
}

// ============================================================================
//  AUDIO ENGINE
// ============================================================================
void playAudio(uint8_t track) {
    if (track == TRACK_NONE) {
        stopAudio();
        return;
    }
    currentTrack = track;
    audioLooping = false;   // play once, do not re-trigger on DFPlayerPlayFinished
    dfPlayer.playFolder(FOLDER_ROBOT, track);
}

void stopAudio() {
    dfPlayer.stop();
    currentTrack = TRACK_NONE;
    audioLooping = false;
}

void updateAudio() {
    if (dfPlayer.available()) {
        uint8_t type  = dfPlayer.readType();
        int     value = dfPlayer.read();

        if (type == DFPlayerPlayFinished) {
            if (currentMode == MODE_MP3) {
                if (mp3LoopCurrent) {
                    dfPlayer.playFolder(FOLDER_MP3, currentTrack);
                } else {
                    nextMp3Track(millis());   // not looping -- auto-advance when a track ends
                }
            } else if (audioLooping && currentTrack != TRACK_NONE) {
                dfPlayer.playFolder(FOLDER_ROBOT, currentTrack);
            }
        } else if (type == DFPlayerError) {
            Serial.print(F("DFPlayer Error "));
            Serial.print(value);
            Serial.print(F(" ("));
            switch (value) {
                case 1: Serial.print(F("Busy/module not ready"));      break;
                case 2: Serial.print(F("Sleeping"));                   break;
                case 3: Serial.print(F("Serial wrong stack"));         break;
                case 4: Serial.print(F("Checksum mismatch"));          break;
                case 5: Serial.print(F("File index out of range"));   break;
                case 6: Serial.print(F("File mismatch/not found"));    break;
                case 7: Serial.print(F("Advertise (in-play prompt)")); break;
                default: Serial.print(F("Unknown"));                  break;
            }
            Serial.print(F(") while requesting /"));
            Serial.print(currentMode == MODE_MP3 ? FOLDER_MP3 : FOLDER_ROBOT);
            Serial.print(F("/"));
            Serial.println(currentTrack);

            // A missing/broken file never sends DFPlayerPlayFinished, so without this
            // it would just go silent and sit there forever -- looping or not -- until
            // someone notices and taps next manually. Skip past it automatically instead.
            if (currentMode == MODE_MP3 && (value == 5 || value == 6)) {
                nextMp3Track(millis());
            }
        }
    }
}

// ============================================================================
//  SENSOR READING  (Robot mode -- call every loop iteration while active)
// ============================================================================
void readSensors(unsigned long now) {
    // -- PIR --
    pirDetected = (digitalRead(PIN_PIR) == HIGH);

    unsigned long tempInterval = (currentState == ST_TEMP_COOLDOWN)
                                    ? TEMP_COOLDOWN_READ_INTERVAL
                                    : TEMP_READ_INTERVAL;

    if (now - lastTempRead >= tempInterval) {
        lastTempRead = now;
        float t = sht30.readTemperature();
        if (!isnan(t)) {
            currentTemp = t;

            if (currentState == ST_TEMP_COOLDOWN) {
                tempCooldownSum += t;
                tempCooldownCount++;
            }

            tempExceedsHot  = (currentTemp > TEMP_HOT_THRESHOLD);
            tempExceedsCold = (currentTemp < TEMP_COLD_THRESHOLD);
        }
    }

    // -- MPU6500 tilt (raw driver) --
    int16_t rawX, rawY, rawZ;
    if (mpuReadAccel(rawX, rawY, rawZ)) {
        float ax = (rawX / MPU_ACCEL_SCALE) * MPU_GRAVITY;
        float ay = (rawZ / MPU_ACCEL_SCALE) * MPU_GRAVITY;   // old Z -> front/back tilt (physical mount rotated 90deg)
        float az = (rawY / MPU_ACCEL_SCALE) * MPU_GRAVITY;   // old Y -> "up" (gravity axis)

        float pitchDeg = atan2f(ay, az) * 180.0f / PI;
        float rollDeg  = atan2f(ax, az) * 180.0f / PI;

        if (!tiltBaselineSet) {
            lastPitchDeg    = pitchDeg;
            lastRollDeg     = rollDeg;
            tiltBaselineSet = true;
        }

        float pitchDelta = fabsf(wrapDelta(pitchDeg - lastPitchDeg));
        float rollDelta  = fabsf(wrapDelta(rollDeg  - lastRollDeg));

        tiltDetected = (pitchDelta > TILT_DELTA_THRESHOLD_DEG ||
                        rollDelta  > TILT_DELTA_THRESHOLD_DEG);

        lastPitchDeg = pitchDeg;
        lastRollDeg  = rollDeg;
    }
}

// ============================================================================
//  RUB TRACKING  (Robot mode only)
// ============================================================================
void updateRubTracking(unsigned long now) {
    bool pad1 = (digitalRead(PIN_TTP_RUB_1) == HIGH);
    bool pad2 = (digitalRead(PIN_TTP_RUB_2) == HIGH);
    bool anyPad = (pad1 || pad2);   // simultaneous touch is fine now -- a real
                                    // stroke often clips both pads for an instant,
                                    // and that should never wipe out progress.

    if (anyPad) {
        isRubbing   = true;
        lastRubTime = now;

        if (rubStartTime == 0) {
            // First touch of a new rub gesture
            rubStartTime   = now;
            rubAccumulated = 0;
        } else {
            rubAccumulated = now - rubStartTime;
        }
        lastActivePad = pad1 ? RUB_PAD_1 : RUB_PAD_2;  // kept for diagnostics only
    } else {
        isRubbing = false;
        if (now - lastRubTime > RUB_RESET_TIMEOUT) {
            // No touch on either pad for a while -- genuine gap, reset the gesture
            rubAccumulated = 0;
            rubStartTime   = 0;
            lastActivePad  = RUB_PAD_NONE;
        }
        // If still within RUB_RESET_TIMEOUT, treat this as a brief gap mid-gesture:
        // rubStartTime is left alone so rubAccumulated keeps growing on next touch.
    }
}

// ============================================================================
//  MP3 MODE
// ============================================================================

void displayMusicScreen(bool showOverlay) {
    display.clearDisplay();

    if (showOverlay) {
        // Info overlay takes priority -- the music frame is cleared/paused
        // entirely while this is up, not drawn underneath the text.
        display.setTextColor(SH110X_WHITE);
        display.setTextSize(2);

        display.setCursor(34, 2);

        // currentMp3Track is already the actual file number within /02/,
        // so it directly reflects what filename to expect on the card.
        // display.print(F("Track "));
        // if (currentMp3Track < 100) display.print('0');
        if (currentMp3Track < 10)  display.print('0');
        display.print(currentMp3Track);
        display.print('/');
        display.println(mp3TrackCount);

        // Volume bar: outlined track + a filled portion proportional to music volume
        display.setTextSize(1);
        display.setCursor(2, 26);
        display.print("Vol: ");
        display.print(musicVolume);
        display.print(F("    Loop "));
        display.print(mp3LoopCurrent ? F("ON") : F("OFF"));
        // Volume bar
        const int barX = 2, barY = 40, barW = SCREEN_WIDTH - 4, barH = 12;
        display.drawRect(barX, barY, barW, barH, SH110X_WHITE);
        int fillW = (int)((long)(barW - 2) * musicVolume / MUSIC_VOLUME_MAX);
        if (fillW > 0) {
            display.fillRect(barX + 1, barY + 1, fillW, barH - 2, SH110X_WHITE);
        }
    } else {
        // Normal state: just cycle the music frame, no text on top of it.
        static const uint8_t musicFrames[3] = { FR_MUSIC_01, FR_MUSIC_02, FR_MUSIC_03 };
        uint8_t frameIdx = musicFrames[musicAnimFrame];
        display.drawBitmap(0, 0, frameBitmaps[frameIdx],
                           SCREEN_WIDTH, SCREEN_HEIGHT, SH110X_WHITE);
    }

    display.display();
}

// Call this whenever a volume or track change happens: shows the info
// overlay immediately and arms the 2s window before it reverts to the
// plain frame-cycling animation.
void showMp3Overlay(unsigned long now) {
    mp3OverlayUntil      = now + MP3_OVERLAY_DURATION_MS;
    lastMusicFrameChange = now;   // resume frame cycling fresh once overlay ends
    displayMusicScreen(true);
}

// Call every loop iteration while in MP3 mode -- cycles FR_MUSIC_01/02/03
// every MUSIC_FRAME_DURATION_MS, mirroring the same loop pattern the Robot
// mode's other animations use.
void updateMusicAnimation(unsigned long now) {
    if (now < mp3OverlayUntil) {
        return;   // info overlay is still showing -- leave it up, don't touch frames
    }
    if (mp3Paused) {
        return;   // paused -- leave the current frame up, don't cycle
    }
    if (now - lastMusicFrameChange >= MUSIC_FRAME_DURATION_MS) {
        lastMusicFrameChange = now;
        musicAnimFrame = (musicAnimFrame + 1) % 3;
        displayMusicScreen(false);
    }
}

void playCurrentMp3Track() {
    dfPlayer.playFolder(FOLDER_MP3, currentMp3Track);
    currentTrack = currentMp3Track;
    mp3Paused = false;
}

void nextMp3Track(unsigned long now) {
  // Debounce: If we advanced a track less than 500ms ago, ignore this duplicate trigger
  if (now - lastTrackAdvanceTime < 500) return; 
  lastTrackAdvanceTime = now;

  currentMp3Track++;
  if (currentMp3Track > mp3TrackCount) {
    currentMp3Track = 1;
  }
  playCurrentMp3Track();
  showMp3Overlay(now);
}

void prevMp3Track(unsigned long now) {
  // Debounce: If we advanced a track less than 500ms ago, ignore this duplicate trigger
  if (now - lastTrackAdvanceTime < 500) return; 
  lastTrackAdvanceTime = now;

  if (currentMp3Track <= 1) {
    currentMp3Track = mp3TrackCount;
  } else {
    currentMp3Track--;
  }
  playCurrentMp3Track();
  showMp3Overlay(now);
}

void toggleMp3PlayPause() {
    if (mp3Paused) {
        dfPlayer.start();
        mp3Paused = false;
        Serial.println(F("[MP3] Resume"));
    } else {
        dfPlayer.pause();
        mp3Paused = true;
        Serial.println(F("[MP3] Pause"));
    }
    showMp3Overlay(millis());
}
// ============================================================================
//  MODE TRANSITIONS
// ============================================================================
void enterMp3Mode() {
    currentMode = MODE_MP3;

    stopAudio();

    rubAccumulated          = 0;
    rubStartTime            = 0;
    lastRubTime             = 0;
    isRubbing               = false;
    lastActivePad           = RUB_PAD_NONE;
    tempCooldownSum         = 0.0f;
    tempCooldownCount       = 0;
    tiltDetected            = false;
    cycleAngryUsed          = false;
    cycleSadUsed            = false;
    happyPreventsAngrySad   = false;

    // Initialize MP3 mode defaults
    musicVolume = MUSIC_DEFAULT_VOLUME;
    dfPlayer.volume(musicVolume);
    currentMp3Track = 1;
    mp3LoopCurrent  = false;

    // Query how many tracks are in /02/ right now -- this is what lets you just
    // drop in a new sequentially-numbered file with no code changes at all.
    uint16_t count = dfPlayer.readFileCountsInFolder(FOLDER_MP3);
    mp3TrackCount = (count > 0) ? count : 1;  // fallback if query fails or folder is empty

    volUpBtn             = ButtonHoldState();
    volDownBtn           = ButtonHoldState();
    musicAnimFrame       = 0;
    lastMusicFrameChange = millis();

    playCurrentMp3Track();
    showMp3Overlay(millis());

    Serial.println(F("MODE -> MP3"));
}
void enterRobotMode() {
    currentMode = MODE_ROBOT;

    cycleAngryUsed          = false;
    cycleSadUsed            = false;
    happyPreventsAngrySad   = false;

    rubAccumulated          = 0;
    rubStartTime            = 0;
    lastRubTime             = 0;
    isRubbing               = false;
    lastActivePad           = RUB_PAD_NONE;
    tiltDetected            = false;
    tempCooldownSum         = 0.0f;
    tempCooldownCount       = 0;

    enterState(ST_PLAIN);

    volUpBtn   = ButtonHoldState();
    volDownBtn = ButtonHoldState();

    Serial.println(F("MODE -> ROBOT (PLAIN)"));
}

// Mode button (pin 9): tap WAKE_TAP_COUNT times quickly while ASLEEP to wake to plain.
// In MP3 mode, double-tap toggles looping the current track vs. auto-advancing to
// the next one when it ends (see MP3_LOOP_TOGGLE_TAP_COUNT).
// Hold 5s (from either mode) to toggle Robot <-> MP3.
void handleModeButton(unsigned long now) {
    bool pressed = (digitalRead(PIN_TTP_MODE) == HIGH);

    if (pressed) {
        if (!modeBtn.pressed) {
            modeBtn.pressed        = true;
            modeBtn.pressStart     = now;
            modeBtn.longActionDone = false;
        } else if (!modeBtn.longActionDone &&
                   (now - modeBtn.pressStart >= MODE_HOLD_MS)) {
            modeBtn.longActionDone = true;  // guard: only fire once per hold
            modeTapCount = 0;               // a long hold cancels any tap sequence in progress
            if (currentMode == MODE_ROBOT) {
                enterMp3Mode();
            } else {
                enterRobotMode();
            }
        }
    } else {
        if (modeBtn.pressed && !modeBtn.longActionDone) {
            // Released after a short press -- was it quick enough to count as a tap?
            unsigned long pressDuration = now - modeBtn.pressStart;
            if (pressDuration <= WAKE_TAP_MAX_PRESS_MS) {
                if (modeTapCount > 0 && (now - modeLastTapTime) > WAKE_TAP_MAX_GAP_MS) {
                    modeTapCount = 0;   // previous tap too long ago -- start a fresh sequence
                }
                if (modeTapCount == 0 && currentMode == MODE_MP3) {
                    mp3WasPlaying = !mp3Paused;   // remember the play/pause state so we can restore it after the tap sequence
                }
                modeTapCount++;
                modeLastTapTime = now;

                if (currentMode == MODE_ROBOT && currentState == ST_SLEEP &&
                    modeTapCount >= WAKE_TAP_COUNT)
                {
                    modeTapCount = 0;
                    enterState(ST_PLAIN);
                    dfPlayer.playFolder(FOLDER_ROBOT, TRACK_GREET);
                    currentTrack = TRACK_GREET;
                    audioLooping = false;
                }
                else if (currentMode == MODE_MP3 && modeTapCount >= MP3_LOOP_TOGGLE_TAP_COUNT)
                {
                    modeTapCount = 0;
                    mp3LoopCurrent = !mp3LoopCurrent;
                    if (mp3WasPlaying == mp3Paused) {
                        toggleMp3PlayPause();   // restore play/pause state after the tap sequence
                    }else{
                        showMp3Overlay(now);   // just show the overlay if we didn't change play/pause state
                    }
                }
                else if (currentMode == MODE_MP3 && modeTapCount == 1) {
                    // Fires immediately on this release, no waiting to see if a 2nd tap follows.
                    toggleMp3PlayPause();
                }
            } else {
                modeTapCount = 0;   // held too long to be a tap -- break the sequence
            }
        }
        modeBtn.pressed        = false;
        modeBtn.longActionDone = false;
    }

    // Drop a stalled tap sequence even if the button hasn't been pressed again
    if (modeTapCount > 0 && !modeBtn.pressed && (now - modeLastTapTime) > WAKE_TAP_MAX_GAP_MS) {
        modeTapCount = 0;
    }
}

void handleMusicButtons(unsigned long now) {
    // -- Volume Up / Next --
    bool p1 = (digitalRead(PIN_TTP_RUB_1) == HIGH);
    if (p1) {
        if (!volUpBtn.pressed) {
            volUpBtn.pressed        = true;
            volUpBtn.pressStart     = now;
            volUpBtn.longActionDone = false;
            volUpBtn.lastStepTime   = now;
        } else if (now - volUpBtn.pressStart >= VOLUME_HOLD_MS) {
            if (!volUpBtn.longActionDone ||
                now - volUpBtn.lastStepTime >= VOLUME_RAMP_INTERVAL_MS) {
                volUpBtn.longActionDone = true;
                volUpBtn.lastStepTime   = now;
                if (musicVolume < MUSIC_VOLUME_MAX) {
                    musicVolume++;
                    dfPlayer.volume(musicVolume);
                    showMp3Overlay(now);
                }
            }
        }
    } else {
        if (volUpBtn.pressed && !volUpBtn.longActionDone) {
            nextMp3Track(now);   // short press -> next track
        }
        volUpBtn.pressed        = false;
        volUpBtn.longActionDone = false;
    }

    // -- Volume Down / Previous --
    bool p2 = (digitalRead(PIN_TTP_RUB_2) == HIGH);
    if (p2) {
        if (!volDownBtn.pressed) {
            volDownBtn.pressed        = true;
            volDownBtn.pressStart     = now;
            volDownBtn.longActionDone = false;
            volDownBtn.lastStepTime   = now;
        } else if (now - volDownBtn.pressStart >= VOLUME_HOLD_MS) {
            if (!volDownBtn.longActionDone ||
                now - volDownBtn.lastStepTime >= VOLUME_RAMP_INTERVAL_MS) {
                volDownBtn.longActionDone = true;
                volDownBtn.lastStepTime   = now;
                if (musicVolume > MUSIC_VOLUME_MIN) {
                    musicVolume--;
                    dfPlayer.volume(musicVolume);
                    showMp3Overlay(now);
                }
            }
        }
    } else {
        if (volDownBtn.pressed && !volDownBtn.longActionDone) {
            prevMp3Track(now);   // short press -> previous track
        }
        volDownBtn.pressed        = false;
        volDownBtn.longActionDone = false;
    }
}

// ============================================================================
//  MAIN LOOP
// ============================================================================
void loop() {
    unsigned long now = millis();

    handleSerialDebug();
    updateAudio();
    handleModeButton(now);

    if (currentMode == MODE_MP3) {
        handleMusicButtons(now);
        updateMusicAnimation(millis());  // fresh timestamp -- see the comment on the
                                          // updateAnimation() call further down for why
        return;
    }

    readSensors(now);
    updateRubTracking(now);

    // ---- Global overrides (highest priority) ----

    // Dizzy override -- from ANY Robot-mode state except already dizzy
    if (currentState != ST_DIZZY && tiltDetected) {
        enterState(ST_DIZZY);
        return;
    }

    // Temperature extreme -- from SLEEP or PLAIN only
    if (currentState == ST_SLEEP || currentState == ST_PLAIN) {
        if (tempExceedsHot) {
            enterState(ST_HOT);
            return;
        }
        if (tempExceedsCold) {
            enterState(ST_FREEZE);
            return;
        }
    }

    // ---- State-specific logic ----
    unsigned long stateElapsed = now - stateStartTime;   // always reflects the CURRENT state,
                                                          // since nothing above falls through
                                                          // to here after changing currentState
    switch (currentState) {

        case ST_SLEEP:
            if (rubAccumulated >= RUB_WAKE_THRESHOLD) {
                enterState(ST_WAKE_RUB);
            } else if (stateElapsed >= SLEEP_PIR_REARM_DELAY && pirDetected) {
                // PIR is ignored for the first SLEEP_PIR_REARM_DELAY ms of sleep.
                // Only after that window do we even look at it again.
                enterState(ST_PLAIN);
                dfPlayer.playFolder(FOLDER_ROBOT, TRACK_GREET);
                currentTrack = TRACK_GREET;
                audioLooping = false;
            }
            break;

        case ST_PLAIN:
            if (rubAccumulated >= RUB_HAPPY_THRESHOLD &&
                stateElapsed < DUR_PLAIN_ANGRY_TRIGGER)
            {
                stateAudioTrack = TRACK_HAPPY;
                enterState(ST_HAPPY);
            }
            else if (stateElapsed >= DUR_PLAIN_ANGRY_TRIGGER) {
                if (!happyPreventsAngrySad && !cycleAngryUsed) {
                    enterState(ST_ANGRY);
                } else if (stateElapsed >= PLAIN_INACTIVITY_SLEEP_MS) {
                    // Already been through the angry/sad cycle (or happy) this
                    // wake -- no more of those, so fall asleep after this long
                    // with no rub, regardless of PIR.
                    enterState(ST_SLEEP);
                }
            }
            break;

        case ST_ANGRY:
            if (rubAccumulated >= RUB_HAPPY_THRESHOLD) {
                stateAudioTrack = TRACK_ANGRY_HAPPY;
                enterState(ST_HAPPY);
            } else if (stateElapsed >= DUR_ANGRY) {
                if (!happyPreventsAngrySad && !cycleSadUsed) {
                    enterState(ST_SAD);
                } else {
                    enterState(ST_PLAIN);
                }
            }
            break;

        case ST_SAD:
            if (rubAccumulated >= RUB_HAPPY_THRESHOLD) {
                stateAudioTrack = TRACK_SAD_HAPPY;
                enterState(ST_HAPPY);
            } else if (stateElapsed >= DUR_SAD) {
                enterState(ST_PLAIN);
            }
            break;

        case ST_HAPPY:
            if (stateElapsed >= DUR_HAPPY) {
                enterState(ST_PLAIN);
            }
            break;

        case ST_DIZZY:
            if (stateElapsed >= DUR_DIZZY) {
                enterState(ST_PLAIN);
            }
            break;

        case ST_HOT:
            if (stateElapsed >= DUR_HOT) {
                enterState(ST_TEMP_COOLDOWN);
            }
            break;

        case ST_FREEZE:
            if (stateElapsed >= DUR_FREEZE) {
                enterState(ST_TEMP_COOLDOWN);
            }
            break;

        case ST_WAKE_RUB:
            if (stateElapsed >= DUR_WAKE_RUB_TOTAL) {
                stateAudioTrack = TRACK_HAPPY_SLEEP;
                enterState(ST_HAPPY);
            }
            break;

        case ST_TEMP_COOLDOWN:
            if (stateElapsed >= DUR_TEMP_COOLDOWN) {
                float avgTemp = currentTemp;
                if (tempCooldownCount > 0) {
                    avgTemp = tempCooldownSum / tempCooldownCount;
                }
                tempCooldownSum   = 0.0f;
                tempCooldownCount = 0;

                if (avgTemp > TEMP_HOT_THRESHOLD) {
                    enterState(ST_HOT);
                } else if (avgTemp < TEMP_COLD_THRESHOLD) {
                    enterState(ST_FREEZE);
                } else {
                    enterState(ST_PLAIN);
                }
            }
            break;

        default:
            break;
    }

    updateAnimation(millis());
}